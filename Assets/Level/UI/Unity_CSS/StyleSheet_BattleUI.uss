

.unit-icon {
    top: 5%;
    bottom: 5%;
    height: 90%;
    width: 15.5%;
}

.route-bar{
    position : absolute;
    top : 18px;
    right : 11%;
    width : 34%;
    height : 28px;
    margin : 0;
}

.route-line{
    position : absolute;
    left:0;
    right:0;
    top:12px;
    width:auto;
    height:4px;
    margin:0;
    background-color:rgb(200,200,200);
}

.route-marker{
    position:absolute;
    top:14px;
    width:18px;
    height:18px;
    margin: -9px 0 0 -9px;
    border-radius : 9px;
    border-width:2px;
    border-color:rgb(255,255,255);
}

.route-marker-battle{
   background-color: rgb(220,70,70);
}

.route-marker-event{
    background-color : rgb(240,200,60);
}

.route-marker-goal{
    width:26px;
    height:26px;
    margin:-13px 0 0 -13px;
    border-radius : 13px;
    background-color :rgb(110,210,130);
}

.route-marker-passed{
    opacity : 0.35;
}

.route-train{
    position:absolute;
    top:14px;
    width:14px;
    height:14px;
    margin:-7px 0 0 -7px;
    border-radius: 7px;
    background-color:rgb(255,255,255);
}

.fuel-Wrapper {
    border: 2px;
    width: 100%;
    height: 100%;
    align-items: stretch;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.fuel-BackGround {
    background-color: rgb(30, 30, 30);
    overflow: hidden;
    width: 100%;
    height: 100%;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.fuel-Fill {
    height: 100%;
    width: 50%;
    background-color: rgb(255, 100, 0);
}

.unit-icon-deployed {
    opacity: 0.4;
}

.revive-overlay {
    position: absolute;
    left:0;
    top:0;
    width: 100%;
    height: 100%;
    margin: 0;
    align-items:center;
    justify-content:center;
    background-color:rgba(0,0,0,0.6);
}

.revive-panel{
    width:auto;
    height:auto;
    margin:0;
    padding:24px 40px;
    align-items:center;
    background-color:rgb(20,20,24);
    border-width:3px;
    border-color:rgb(255,255,255);
    border-radius:12px;
}

.revive-icon{
    width : 96px;
    height : 96px;
    margin : 0 0 12px 0;
    border-width: 2px;
    border-color:rgb(200,200,200);
    border-radius:24px;
    -unity-background-scale-mode:scale-to-fit;
}

.revive-cost-label{
    margin:0 0 16px 0;
    font-size : 24px;
    color : rgb(255,255,255);
}

.revive-button-row{
    flex-direction : row;
    width : auto;
    height : auto;
    margin : 0;
}

.revive-confirm-button,
.revive-cancel-button{
    width : 120px;
    height : 48px;
    margin : 0 8px;
    font-size:22px;
}

.unit-icon-revive-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 0%;
    margin: 0;
    background-color: rgba(120, 220, 140, 0.55);
}

.unit-icon-revive-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    -unity-text-align: middle-center;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.result-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    margin: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.result-panel {
    width: auto;
    height: auto;
    margin: 0;
    align-items: center;
}

.result-header {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.result-header-cleared {
    color: rgb(120, 220, 140);
}

.result-header-failed {
    color: rgb(230, 90, 90);
}

.result-hint {
    margin-top: 24px;
    font-size: 20px;
    color: rgb(200, 200, 200);
}

.unit-icon-dead {
    opacity: 0.6;
    -unity-background-image-tint-color: rgb(90, 90, 90);
}

.stage-select-screen {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 5%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(24, 26, 34);
}

.stage-select-character {
    width: 40%;
    height: 80%;
    margin: 0;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.05);
}

.stage-select-list-panel{
    width : 45%;
    height : 80%;
    margin : 0;
    padding : 16px;
    flex-direction : column;
    align-items:stretch;
    justify-content:flex-start;
    border-width : 2px;
    border-color:rgb(200,200,200);
}

.stage-select-header{
    margin : 0 0 16px 0;
    font-size:28px;
    color : rgb(230,230,230);
    -unity-text-align : middle-left;
}

.stage-select-list{
    flex-direction:column;
    align-items:flex-end;
}

.stage-select-button{
    width : 70%;
    height : 72px;
    margin : 0 0 12px 0;
    font-size : 20px;
    -unity-text-align : middle-center;
}

.stage-select-empty{
    border-width:2px;
    border-color:rgba(200,200,200,0.35);
    background-color:rgba(255,255,255,0.03);
}
.title-screen {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(24, 26, 34);
}

.title-still {
    width: 40%;
    height: 70%;
    margin: 0;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.05);
}

.title-logo {
    position: absolute;
    top: 8%;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.title-tap {
    position: absolute;
    bottom: 8%;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.title-tap-dim {
    opacity: 0.15;
}

.menu-button {
    position: absolute;
    right: 2%;
    top: 3%;
    width: 56px;
    height: 56px;
    margin: 0;
    padding: 0;
    border-radius: 28px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.4);
    align-items: center;
    justify-content: center;
}

.menu-button-line {
    width: 60%;
    height: 4px;
    margin: 3px 0;
    border-radius: 2px;
    background-color: rgb(255, 255, 255);
}

.unit-select-screen {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 72px 4% 3% 4%;
    flex-direction: column;
    background-color: rgb(24, 26, 34);
}

.us-top {
    flex-direction: row;
    width: 100%;
    height: 62%;
    margin: 0 0 2% 0;
}

.us-train-panel {
    width: 22%;
    height: 100%;
    margin: 0 3% 0 0;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.05);
}

.us-train-image {
    width: 100%;
    height: 100%;
    margin: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.us-slot-row {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    height: 100%;
    margin: 0;
}

.us-unit-slot {
    flex-grow: 1;
    flex-basis: 0;
    height: 100%;
    margin: 0 4px;
    padding: 0;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.05);
    -unity-background-scale-mode: scale-to-fit;
}

.us-bottom {
    flex-direction: row;
    width: 100%;
    height: 30%;
    margin: 0;
}

.us-train-list {
    width: 22%;
    height: 100%;
    margin: 0 3% 0 0;
}

.us-unit-list {
    flex-grow: 1;
    height: 100%;
    margin: 0;
}

.us-candidate {
    width: 96px;
    height: 96px;
    margin: 0 8px 0 0;
    padding: 0;
    border-width: 2px;
    border-color: rgb(120, 120, 120);
    background-color: rgba(255, 255, 255, 0.05);
    -unity-background-scale-mode: scale-to-fit;
}

.us-candidate-selected {
    border-color: rgb(255, 214, 64);
    opacity: 0.5;
}

.us-back-button {
    position: absolute;
    left: 4%;
    top: 12px;
    width: 120px;
    height: 44px;
    margin: 0;
    font-size: 20px;
}

.us-confirm-button {
    position: absolute;
    right: 12%;
    top: 12px;
    width: 140px;
    height: 44px;
    margin: 0;
    font-size: 20px;
}

.fuelset-screen{
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:100%;
    margin:0;
    align-items:center;
    justify-content:center;
    background-color:rgb(24,26,34);
}

.fs-fuel-container{
    position : absolute;
    left : 4%;
    top:12px;
    width : 40%;
    height : 40px;
    margin : 0;
}

.fs-train-image{
    width:70%;
    height:60%;
    margin:0;
    -unity-background-scale-mode : scale-to-fit;
}

.fs-tap{
    position:absolute;
    bottom:8%;
    left:0;
    right:0;
    -unity-text-align:middle-center;
    font-size:36px;
    -unity-font-style:bold;
    color:rgb(255,255,255);
    opacity:1;
    transition-property:opacity;
    transition-duration : 0.6s;
}

.fs-tap-dim{
    opacity:0.15;
}

.alert-overlay{
    position : absolute;
    left : 0;
    top : 0;
    width : 100%;
    height : 100%;
    margin : 0;
    background-color :rgba(255,0,0,0.35);
    opacity :1;
    transition-property:opacity;
    transition-duration:0.2s;
}

.alert-overlay-dim{
    opacity:0;
}

.battle-buttons{
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:100%;
    margin:0;
}

.battle-return-button{
    position:absolute;
    left:2%;
    bottom:5%;
    width:72px;
    height:72px;
    margin:0;
    padding:0;
    border-radius:36px;
    font-size:13px;
}

.battle-ram-button{
    position:absolute;
    right:3%;
    bottom:5%;
    width:96px;
    height:96px;
    margin:0;
    padding:0;
    border-radius:48px;
    border-width:3px;
    border-color:rgb(255,255,255);
    background-color:rgba(200,40,40,0.8);
    font-size:22px;
    -unity-font-style:bold;
}

.sr-screen{
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:100%;
    margin:0;
    padding:72px 6% 5% 6%;
    flex-direction:row;
    align-items:center;
    justify-content:space-between;
    background-color:rgba(10,12,18,0.92);
}

.sr-mvp-frame{
    width:36%;
    height:80%;
    margin : 0;
    border-width:2px;
    border-color:rgb(200,200,200);
    background-color:rgba(255,255,255,0.05);
}

.sr-mvp-image {
    width: 100%;
    height: 100%;
    margin: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.sr-right {
    width: 52%;
    height: 80%;
    margin: 0;
    justify-content: flex-start;
}

.sr-fuel-label {
    margin: 0 0 24px 0;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(120, 220, 140);
}

.sr-fuel-negative {
    color: rgb(230, 90, 90);
}

.sr-row-container {
    width: 100%;
    height: auto;
    margin: 0;
}

.sr-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 48px;
    margin: 0 0 8px 0;
}

.sr-row-icon {
    width: 44px;
    height: 44px;
    margin: 0 12px 0 0;
    -unity-background-scale-mode: scale-to-fit;
}

.sr-bar-track {
    flex-grow: 1;
    flex-basis: 0;
    height: 16px;
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    background-color: rgb(40, 40, 48);
}

.sr-bar-fill {
    height: 100%;
    margin: 0;
    background-color: rgb(255, 170, 60);
}

.sr-row-value {
    width: 72px;
    margin: 0 0 0 12px;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-right;
}

.menu-overlay{
    position : absolute;
    left:0;
    top:0;
    width:100%;
    height:100%;
    margin :0;
    align-items:center;
    justify-content : center;
    background-color:rgba(0,0,0,0.6);
}

.menu-panel{
    width:auto;
    height:auto;
    margin:0;
    padding:24px 48px;
    align-items:center;
    background-color :rgb(20,20,24);
    border-width : 3px;
    border-color:rgb(255,255,255);
    border-radius:12px;
}

.menu-header{
    margin:0 0 20px 0;
    font-size : 32px;
    -unity-font-style:bold;
    color:rgb(255,255,255);
}

.menu-item-button{
    width:280px;
    height:52px;
    margin:0 0 12px 0;
    font-size :22px;
}

.rs-screen {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 5%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(24, 26, 34);
}

.rs-frame {
    width: 40%;
    height: 80%;
    margin: 0;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.05);
}

.rs-image {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.rs-header {
    position: absolute;
    left: 12px;
    top: 8px;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.rs-header-cleared {
    color: rgb(120, 220, 140);
}

.rs-header-failed {
    color: rgb(230, 90, 90);
}

.rs-right {
    width: 52%;
    height: 80%;
    margin: 0;
    padding: 16px;
    justify-content: flex-start;
}

.rs-count-label {
    margin: 0 0 16px 0;
    font-size: 26px;
    color: rgb(255, 255, 255);
}

.rs-row-container {
    flex-grow: 1;
}

.rs-row {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin: 0 0 10px 0;
}

.rs-row-icon {
    width: 56px;
    height: 56px;
    margin: 0 12px 0 0;
    border-width: 2px;
    border-color: rgb(120, 120, 120);
    -unity-background-scale-mode: scale-to-fit;
}

.rs-bars {
    flex-grow: 1;
}

.rs-bar-line {
    flex-direction: row;
    align-items: center;
    height: 24px;
    margin: 0 0 2px 0;
}

.rs-bar-track {
    flex-grow: 1;
    height: 14px;
    background-color: rgb(50, 50, 60);
}

.rs-bar-fill {
    height: 100%;
}

.rs-bar-fill-dealt {
    background-color: rgb(255, 170, 60);
}

.rs-bar-fill-taken {
    background-color: rgb(220, 80, 80);
}

.rs-bar-value {
    width: 72px;
    margin: 0 0 0 8px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-right;
}

.rs-stat-row {
    flex-direction: row;
    justify-content: space-between;
    margin: 0 0 18px 0;
}

.rs-stat-caption {
    font-size: 26px;
    color: rgb(200, 200, 200);
}

.rs-stat-value {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.rs-row-counts {
    width: 96px;
    margin: 0 8px 0 0;
    justify-content: center;
}

.rs-row-revive {
    font-size: 18px;
    color: rgb(140, 220, 160);
    -unity-text-align: middle-left;
}

.rs-row-death {
    font-size: 18px;
    color: rgb(230, 120, 120);
    -unity-text-align: middle-left;
}

.us-popup{
    position:absolute;
    min-width:220px;
    padding:10px 14px;
    background-color:rgba(10,10,14,0.95);
    border-width:2px;
    border-color:rgb(255,255,255);
    border-radius:8px;
}

    .us-popup-title {
    margin: 0 0 6px 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.us-popup-row {
    flex-direction: row;
    justify-content: space-between;
}

.us-popup-caption {
    margin: 0 16px 0 0;
    font-size: 16px;
    color: rgb(190, 190, 190);
}

.us-popup-value {
    font-size: 16px;
    color: rgb(255, 255, 255);
}

    .us-cost-label {
    position: absolute;
    left: 4%;
    margin-left: 136px;
    top: 12px;
    height: 44px;
    font-size: 24px;
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
}

.us-cost-label-over {
    color: rgb(230, 90, 90);
}

.us-mask {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(110, 110, 110, 0.6);
}

.ev-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0.7);
}

.ev-panel {
    width: 640px;
    height: auto;
    margin: 0;
    padding: 24px 32px;
    align-items: center;
    background-color: rgb(20,20,24);
    border-width: 3px;
    border-color: rgb(255,255,255);
    border-radius: 12px;
}

.ev-image {
    width: 240px;
    height: 160px;
    margin: 0 0 12px 0;
    -unity-background-scale-mode: scale-to-fit;
}

.ev-title {
    font-size: 30px;
    color: rgb(255,255,255);
    -unity-font-style: bold;
    margin: 0 0 8px 0;
}

.ev-body {
    font-size: 20px;
    color: rgb(220,220,220);
    white-space: normal;
    -unity-text-align: upper-center;
    margin: 0 0 16px 0;
}

.ev-choices {
    width: 100%;
    margin: 0;
}

.ev-choice-button {
    width: 100%;
    height: auto;
    margin: 4px 0;
    padding: 10px 16px;
    align-items: flex-start;
}

.ev-choice-label {
    font-size: 22px;
    color: rgb(255,255,255);
}

.ev-choice-desc {
    font-size: 16px;
    color: rgb(190,190,190);
    white-space: normal;
}

.sr-note-container {
    width: 100%;
    margin: 0 0 16px 0;
}

.sr-note {
    margin: 0 0 4px 0;
    font-size: 20px;
    color: rgb(255, 230, 160);
}
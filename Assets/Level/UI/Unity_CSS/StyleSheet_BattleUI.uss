

.unit-icon {
    top: 5%;
    bottom: 5%;
    height: 90%;
    width: 15.5%;
}

.route-bar{
    position : absolute;
    top : 18px;
    right : 11%;
    width : 34%;
    height : 28px;
    margin : 0;
}

.route-line{
    position : absolute;
    left:0;
    right:0;
    top:12px;
    width:auto;
    height:4px;
    margin:0;
    background-color:rgb(200,200,200);
}

.route-marker{
    position:absolute;
    top:14px;
    width:18px;
    height:18px;
    margin: -9px 0 0 -9px;
    border-radius : 9px;
    border-width:2px;
    border-color:rgb(255,255,255);
}

.route-marker-battle{
   background-color: rgb(220,70,70);
}

.route-marker-event{
    background-color : rgb(240,200,60);
}

.route-marker-goal{
    width:26px;
    height:26px;
    margin:-13px 0 0 -13px;
    border-radius : 13px;
    background-color :rgb(110,210,130);
}

.route-marker-passed{
    opacity : 0.35;
}

.route-train{
    position:absolute;
    top:14px;
    width:14px;
    height:14px;
    margin:-7px 0 0 -7px;
    border-radius: 7px;
    background-color:rgb(255,255,255);
}

.fuel-Wrapper {
    border: 2px;
    width: 100%;
    height: 100%;
    align-items: stretch;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.fuel-BackGround {
    background-color: rgb(30, 30, 30);
    overflow: hidden;
    width: 100%;
    height: 100%;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.fuel-Fill {
    height: 100%;
    width: 50%;
    background-color: rgb(255, 100, 0);
}

.unit-icon-deployed {
    opacity: 0.4;
}

.revive-overlay {
    position: absolute;
    left:0;
    top:0;
    width: 100%;
    height: 100%;
    margin: 0;
    align-items:center;
    justify-content:center;
    background-color:rgba(0,0,0,0.6);
}

.revive-panel{
    width:auto;
    height:auto;
    margin:0;
    padding:24px 40px;
    align-items:center;
    background-color:rgb(20,20,24);
    border-width:3px;
    border-color:rgb(255,255,255);
    border-radius:12px;
}

.revive-icon{
    width : 96px;
    height : 96px;
    margin : 0 0 12px 0;
    border-width: 2px;
    border-color:rgb(200,200,200);
    border-radius:24px;
    -unity-background-scale-mode:scale-to-fit;
}

.revive-cost-label{
    margin:0 0 16px 0;
    font-size : 24px;
    color : rgb(255,255,255);
}

.revive-button-row{
    flex-direction : row;
    width : auto;
    height : auto;
    margin : 0;
}

.revive-confirm-button,
.revive-cancel-button{
    width : 120px;
    height : 48px;
    margin : 0 8px;
    font-size:22px;
}

.unit-icon-revive-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 0%;
    margin: 0;
    background-color: rgba(120, 220, 140, 0.55);
}

.unit-icon-revive-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    -unity-text-align: middle-center;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.result-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    margin: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.result-panel {
    width: auto;
    height: auto;
    margin: 0;
    align-items: center;
}

.result-header {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.result-header-cleared {
    color: rgb(120, 220, 140);
}

.result-header-failed {
    color: rgb(230, 90, 90);
}

.result-hint {
    margin-top: 24px;
    font-size: 20px;
    color: rgb(200, 200, 200);
}

.unit-icon-dead {
    opacity: 0.6;
    -unity-background-image-tint-color: rgb(90, 90, 90);
}

.stage-select-screen {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 5%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(24, 26, 34);
}

.stage-select-character {
    width: 40%;
    height: 80%;
    margin: 0;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.05);
}

.stage-select-list-panel {
    width: 45%;
    height: 80%;
    margin: 0;
    padding: 16px;
    align-items: flex-end;
    justify-content: flex-start;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
}

.stage-select-button {
    width: 50%;
    height: 56px;
    margin: 0 0 12px 0;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.title-screen {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(24, 26, 34);
}

.title-still {
    width: 40%;
    height: 70%;
    margin: 0;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.05);
}

.title-logo {
    position: absolute;
    top: 8%;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.title-tap {
    position: absolute;
    bottom: 8%;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.title-tap-dim {
    opacity: 0.15;
}

.menu-button {
    position: absolute;
    right: 2%;
    top: 3%;
    width: 56px;
    height: 56px;
    margin: 0;
    padding: 0;
    border-radius: 28px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.4);
    align-items: center;
    justify-content: center;
}

.menu-button-line {
    width: 60%;
    height: 4px;
    margin: 3px 0;
    border-radius: 2px;
    background-color: rgb(255, 255, 255);
}

.unit-select-screen {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 72px 4% 3% 4%;
    flex-direction: column;
    background-color: rgb(24, 26, 34);
}

.us-top {
    flex-direction: row;
    width: 100%;
    height: 62%;
    margin: 0 0 2% 0;
}

.us-train-panel {
    width: 22%;
    height: 100%;
    margin: 0 3% 0 0;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.05);
}

.us-train-image {
    width: 100%;
    height: 100%;
    margin: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.us-slot-row {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    height: 100%;
    margin: 0;
}

.us-unit-slot {
    flex-grow: 1;
    flex-basis: 0;
    height: 100%;
    margin: 0 4px;
    padding: 0;
    border-width: 2px;
    border-color: rgb(200, 200, 200);
    background-color: rgba(255, 255, 255, 0.05);
    -unity-background-scale-mode: scale-to-fit;
}

.us-bottom {
    flex-direction: row;
    width: 100%;
    height: 30%;
    margin: 0;
}

.us-train-list {
    width: 22%;
    height: 100%;
    margin: 0 3% 0 0;
}

.us-unit-list {
    flex-grow: 1;
    height: 100%;
    margin: 0;
}

.us-candidate {
    width: 96px;
    height: 96px;
    margin: 0 8px 0 0;
    padding: 0;
    border-width: 2px;
    border-color: rgb(120, 120, 120);
    background-color: rgba(255, 255, 255, 0.05);
    -unity-background-scale-mode: scale-to-fit;
}

.us-candidate-selected {
    border-color: rgb(255, 214, 64);
    opacity: 0.5;
}

.us-back-button {
    position: absolute;
    left: 4%;
    top: 12px;
    width: 120px;
    height: 44px;
    margin: 0;
    font-size: 20px;
}

.us-confirm-button {
    position: absolute;
    right: 12%;
    top: 12px;
    width: 140px;
    height: 44px;
    margin: 0;
    font-size: 20px;
}

.fuelset-screen{
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:100%;
    margin:0;
    align-items:center;
    justify-content:center;
    background-color:rgb(24,26,34);
}

.fs-fuel-container{
    position : absolute;
    left : 4%;
    top:12px;
    width : 40%;
    height : 40px;
    margin : 0;
}

.fs-train-image{
    width:70%;
    height:60%;
    margin:0;
    -unity-background-scale-mode : scale-to-fit;
}

.fs-tap{
    position:absolute;
    bottom:8%;
    left:0;
    right:0;
    -unity-text-align:middle-center;
    font-size:36px;
    -unity-font-style:bold;
    color:rgb(255,255,255);
    opacity:1;
    transition-property:opacity;
    transition-duration : 0.6s;
}

    .fs-tap-dim{
        opacity:0.15;
    }